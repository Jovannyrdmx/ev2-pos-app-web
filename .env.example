# Production secrets: create .env from this file only on the VPS.
# Never commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
PORT=3000
CORS_ORIGINS=https://app.ev2.system,https://pos.ev2.system
# Configure one provider at a time. Keep every real credential only in .env.
# PAYMENT_WEBHOOK_SECRET=
# Mercado Pago: crea una aplicación en Mercado Pago y guarda solo estas llaves en el VPS.
# MP_ACCESS_TOKEN=APP_USR-...
# MP_WEBHOOK_SECRET=
# API_BASE_URL=https://api.ev2.system
# SMTP_URL=
# SMS_PROVIDER_API_KEY=
# EXCHANGE_RATE_SOURCE_URL=
# APP_BASE_URL=https://app.ev2.system
